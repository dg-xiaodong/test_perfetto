# Light-weight config WITHOUT linux.perf: used to test whether the CPU sampler
# perturbs the workload's own latency/queue metrics.
duration_ms: 60000
flush_period_ms: 3000
buffers { size_kb: 32768 fill_policy: RING_BUFFER }
data_sources { config {
  name: "linux.process_stats"
  process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 }
} }
data_sources { config {
  name: "linux.sys_stats"
  sys_stats_config {
    meminfo_period_ms: 1000
    vmstat_period_ms: 1000
    stat_period_ms: 1000
    stat_counters: STAT_CPU_TIMES
    cpufreq_period_ms: 500
  }
} }
data_sources { config {
  name: "track_event"
  track_event_config {
    disabled_categories: "*"
    enabled_categories: "pipeline"
    enabled_categories: "memory"
    enabled_categories: "sync"
    enabled_categories: "io"
    enabled_categories: "demo"
  }
} }
