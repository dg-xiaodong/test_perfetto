# B-window comprehensive config: process_stats + sys_stats + track_event + linux.perf
# No linux.ftrace: board tracefs = UNKNOWN (kernel without CONFIG_FTRACE)
duration_ms: 120000
flush_period_ms: 5000
buffers { size_kb: 65536 fill_policy: RING_BUFFER }

data_sources { config {
  name: "linux.process_stats"
  process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 }
} }

data_sources { config {
  name: "linux.sys_stats"
  sys_stats_config {
    meminfo_period_ms: 1000
    vmstat_period_ms: 1000
    stat_period_ms: 1000
    stat_counters: STAT_CPU_TIMES
    cpufreq_period_ms: 500
  }
} }

data_sources { config {
  name: "linux.system_info"
} }

data_sources { config {
  name: "track_event"
  track_event_config {
    disabled_categories: "*"
    enabled_categories: "pipeline"
    enabled_categories: "memory"
    enabled_categories: "sync"
    enabled_categories: "io"
    enabled_categories: "demo"
  }
} }

data_sources { config {
  name: "linux.perf"
  perf_event_config {
    timebase { counter: SW_CPU_CLOCK frequency: 99 timestamp_clock: PERF_CLOCK_MONOTONIC }
    callstack_sampling { scope { target_cmdline: "pf-demo-x5" } kernel_frames: false }
    ring_buffer_pages: 64
    max_daemon_memory_kb: 16384
  }
} }
