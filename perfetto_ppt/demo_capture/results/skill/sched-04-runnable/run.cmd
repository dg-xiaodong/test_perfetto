skill=perfetto-scheduling-debugging sql=/root/.dsh/skills/perfetto-scheduling-debugging/sql/04-runnable.sql placeholders: utid=213 cpu=0 start=-1 end=-1 category=rdk.latency
/root/.cache/perfetto-skill/trace_processor_shell query /root/sdk_ly_x5_1.1.1/tmp/pfdemo/repo/perfetto_ppt/demo_capture/traces/overview_system_app.pftrace $'-- Individual Runnable intervals; not application queue waiting.\nWITH p AS (SELECT 213 AS utid,-1 AS a,-1 AS b),\nw AS (SELECT utid,CASE WHEN a>=0 THEN a ELSE start_ts END AS a,\n CASE WHEN b>=0 THEN b ELSE end_ts END AS b FROM p CROSS JOIN trace_bounds)\nSELECT st.id,st.utid,st.ts,st.dur,st.state,st.waker_utid,st.waker_id,st.irq_context,\n MIN(st.ts+st.dur,w.b)-MAX(st.ts,w.a) AS overlap_ns\nFROM thread_state st CROSS JOIN w WHERE st.utid=w.utid AND st.state IN (\'R\',\'R+\')\nAND st.dur>0 AND w.b>w.a AND st.ts<w.b AND st.ts+st.dur>w.a ORDER BY st.dur DESC;'
