+    if(NOT EXISTS "${PERFETTO_SDK_DIR}/perfetto.h" OR NOT EXISTS "${PERFETTO_SDK_DIR}/libperfetto.a")
+        message(FATAL_ERROR
+            "PERFETTO_SDK_DIR=${PERFETTO_SDK_DIR} must contain perfetto.h and libperfetto.a")
+    endif()
+    list(APPEND isc_sources
+        rr_perfetto.cc
+        trace_categories.cc
+    )
+endif()
+
+add_library(${module} SHARED
+    ${isc_sources}
+)
+
 add_dependencies(${module}
     create_output_dir
 )
@@ -14,3 +39,14 @@ add_dependencies(${module}
 target_link_libraries(${module}
     pthread
 )
+
+if(CAM_TRACE_TRACK_EVENT)
+    target_include_directories(${module} PRIVATE ${PERFETTO_SDK_DIR})
+    target_link_libraries(${module} PRIVATE ${PERFETTO_SDK_DIR}/libperfetto.a)
+    target_compile_definitions(${module} PRIVATE CAM_TRACE_TRACK_EVENT)
+    set_property(TARGET ${module} PROPERTY CXX_STANDARD 17)
+    set_property(TARGET ${module} PROPERTY CXX_STANDARD_REQUIRED ON)
+    # The static Perfetto SDK is C++; link the shared library through the C++
+    # driver so libstdc++ is pulled in exactly once.
+    set_property(TARGET ${module} PROPERTY LINKER_LANGUAGE CXX)
+endif()
diff --git a/cam_service/service/isc/rr_perfetto.cc b/cam_service/service/isc/rr_perfetto.cc
new file mode 100644
index 000000000..07024236e
--- /dev/null
+++ b/cam_service/service/isc/rr_perfetto.cc
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "rr_perfetto.h"
+
+#include "trace_categories.h"
+
+#include <perfetto.h>
+
+/* Auto-init when libisc.so is loaded (cam_service startup). */
+static __attribute__((constructor)) void rr_perfetto_auto_init(void)
+{
+    rr_perfetto_init();
+}
+
+void rr_perfetto_init(void)
+{
+    perfetto::TracingInitArgs args;
+    /* kSystemBackend connects to the traced daemon. If traced is not running
+     * the SDK degrades gracefully: no crash, events simply dropped. */
+    args.backends = perfetto::kSystemBackend;
+    perfetto::Tracing::Initialize(args);
+    perfetto::TrackEvent::Register();
+}
+
+void rr_perfetto_shutdown(void)
+{
+}
+
+void rr_trace_begin(const char *name)
+{
+    /* DynamicString copies `name` at event time, so a stack buffer is safe. */
+    TRACE_EVENT_BEGIN("camsys", perfetto::DynamicString(name));
+}
+
+void rr_trace_end(void)
+{
+    TRACE_EVENT_END("camsys");
+}
+
+void rr_trace_begin_async(const char *name, uint64_t track_id)
+{
+    TRACE_EVENT_BEGIN("camsys", perfetto::DynamicString(name),
+                      perfetto::Track(track_id));
+}
+
+void rr_trace_end_async(uint64_t track_id)
+{
+    TRACE_EVENT_END("camsys", perfetto::Track(track_id));
+}
