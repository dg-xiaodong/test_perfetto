diff --git a/cam_service/service/include/rr_perfetto.h b/cam_service/service/include/rr_perfetto.h
new file mode 100644
index 000000000..c876db960
--- /dev/null
+++ b/cam_service/service/include/rr_perfetto.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * C-interface shim for the perfetto track_event SDK in cam_service (x5_camsys).
+ * The HAL message handlers are C; they call these wrappers instead of the
+ * C++ perfetto macros directly. Compiled into libisc.so (perfetto module).
+ */
+#ifndef RR_PERFETTO_H
+#define RR_PERFETTO_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Initialize perfetto with the system backend (connects to the traced daemon).
+ * Also done automatically via a library constructor; explicit call is fine. */
+void rr_perfetto_init(void);
+
+/* Optional shutdown; traced handles cleanup. */
+void rr_perfetto_shutdown(void);
+
+/* Begin a tracing slice on the "camsys" category. `name` is copied inside the
+ * SDK, so a stack buffer is safe. MUST pair with rr_trace_end() on every path
+ * that reached the begin. */
+void rr_trace_begin(const char *name);
+
+/* End the most recent slice on the current thread (LIFO). */
+void rr_trace_end(void);
+
+/* Begin an ASYNC slice on the given track. track_id keys the S/F pair across
+ * messages/threads; each unique track_id gets its own track in the UI. */
+void rr_trace_begin_async(const char *name, uint64_t track_id);
+
+/* End the async slice opened on track_id (closes that track's open slice). */
+void rr_trace_end_async(uint64_t track_id);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RR_PERFETTO_H */
\ No newline at end of file
