+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef TRACE_CATEGORIES_H
+#define TRACE_CATEGORIES_H
+
+#include <perfetto.h>
+
+/* One category for the whole camera stack; the slice name
+ * (camsys.isp.hal_msg / camsys.vse.hal_msg / camsys.sif.hal_msg) identifies
+ * the subsystem. The trace config enables it via enabled_categories: "camsys". */
+PERFETTO_DEFINE_CATEGORIES(
+    perfetto::Category("camsys").SetDescription("Camera subsystems (userspace)"),
+);
+
+#endif /* TRACE_CATEGORIES_H */
