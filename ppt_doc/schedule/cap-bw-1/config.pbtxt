# Generated by perfetto-scheduling-debugging 0.1.0 Candidate.
# Source-level configuration basis: Perfetto v57.1/v58.2; runtime must be checked.
# No heapprofd/LD_PRELOAD. No perf scope: preserve cross-process wakers.
duration_ms: 15000
buffers { size_kb: 8192 fill_policy: RING_BUFFER }
data_sources { config { name: "linux.process_stats"
  process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 }
} }
data_sources { config { name: "linux.ftrace"
  ftrace_config { buffer_size_kb: 512 drain_period_ms: 100
    ftrace_events: "sched/sched_switch"
    ftrace_events: "sched/sched_waking"
    ftrace_events: "sched/sched_wakeup_new"
    ftrace_events: "sched/sched_process_exit"
  }
} }
data_sources { config { name: "linux.perf"
  perf_event_config {
    timebase {
      period: 1
      name: "scheduling.switch"
      timestamp_clock: PERF_CLOCK_MONOTONIC
      tracepoint { name: "sched/sched_switch" filter: "prev_pid == 4705" }
    }
    callstack_sampling { kernel_frames: true }
    ring_buffer_pages: 64
    ring_buffer_read_period_ms: 50
    max_enqueued_footprint_kb: 8192
  }
} }
data_sources { config { name: "linux.perf"
  perf_event_config {
    timebase {
      period: 1
      name: "scheduling.waking"
      timestamp_clock: PERF_CLOCK_MONOTONIC
      tracepoint { name: "sched/sched_waking" filter: "pid == 4705" }
    }
    callstack_sampling { kernel_frames: true }
    ring_buffer_pages: 64
    ring_buffer_read_period_ms: 50
    max_enqueued_footprint_kb: 8192
  }
} }
