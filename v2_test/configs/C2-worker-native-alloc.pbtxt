# C2: native allocation attribution for worker_app (heapprofd + sched timeline)
# Prerequisite: libheapprofd_glibc_preload.so matches the collector; target is
# restarted under LD_PRELOAD. See PLAN.md capability preflight.
# The preload child registers android.heapprofd itself; no separate heapprofd
# daemon is required on Linux (Perfetto heapprofd_producer kChild mode).

buffers { size_kb: 8192  fill_policy: RING_BUFFER }   # 0: ftrace
buffers { size_kb: 4096  fill_policy: RING_BUFFER }   # 1: process_stats
buffers { size_kb: 16384 fill_policy: RING_BUFFER }   # 2: heapprofd packets

duration_ms: 45000   # includes the test process startup under LD_PRELOAD

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      record_thread_names: true
      proc_stats_poll_ms: 1000
      record_process_runtime: true
    }
  }
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      buffer_size_kb: 1024
      drain_period_ms: 250
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "kmem/rss_stat"
      ftrace_events: "ftrace/print"
    }
  }
}

data_sources {
  config {
    name: "android.heapprofd"
    target_buffer: 2
    heapprofd_config {
      sampling_interval_bytes: 8192   # start sparse; lower to 4096 only for a focused run
      process_cmdline: "worker_app"
      heaps: "libc.malloc"
      shmem_size_bytes: 8388608       # 8 MiB; raise if client shmem overflow is logged
      block_client: false             # do not turn profiler pressure into app latency
      continuous_dump_config {
        dump_phase_ms: 500
        dump_interval_ms: 2000        # 2 s snapshots, aligned to a few-second jitter
      }
    }
  }
}
