# perfetto-latency-debugging 0.1.1 Candidate; collector-specific schema/runtime still need validation.
duration_ms: 15000
buffers { size_kb: 8192 fill_policy: DISCARD }
data_sources { config {
  name: "track_event"
  track_event_config {
    disabled_categories: "*"
    enabled_categories: "rdk.latency"
  }
} }
data_sources { config {
  name: "linux.ftrace"
  ftrace_config {
    buffer_size_kb: 512
    drain_period_ms: 100
    ftrace_events: "sched/sched_switch"
    ftrace_events: "sched/sched_waking"
  }
} }
data_sources { config {
  name: "linux.process_stats"
  process_stats_config { scan_all_processes_on_start: true proc_stats_poll_ms: 1000 }
} }
