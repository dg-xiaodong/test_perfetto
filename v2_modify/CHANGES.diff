+    (6,  1.0)
+),
+params AS (SELECT 20.0 AS spike_cpu_ms),
+flagged AS (
+  SELECT bucket_s, cpu_ms,
+         CASE WHEN cpu_ms >= (SELECT spike_cpu_ms FROM params) THEN 1 ELSE 0 END AS spike
+  FROM sample
+),
+old_grouped AS (
+  SELECT bucket_s, cpu_ms, spike,
+         bucket_s - ROW_NUMBER() OVER (ORDER BY bucket_s) AS grp
+  FROM flagged
+),
+old_episodes AS (
+  SELECT MIN(bucket_s) AS first_bucket_s, MAX(bucket_s) AS last_bucket_s
+  FROM old_grouped
+  WHERE spike = 1
+  GROUP BY grp
+),
+fixed_spikes AS (
+  SELECT bucket_s, cpu_ms,
+         bucket_s - ROW_NUMBER() OVER (ORDER BY bucket_s) AS grp
+  FROM flagged
+  WHERE spike = 1
+),
+fixed_episodes AS (
+  SELECT MIN(bucket_s) AS first_bucket_s, MAX(bucket_s) AS last_bucket_s
+  FROM fixed_spikes
+  GROUP BY grp
+)
+SELECT 'OLD_merges' AS logic, first_bucket_s, last_bucket_s FROM old_episodes
+UNION ALL
+SELECT 'FIXED_splits', first_bucket_s, last_bucket_s FROM fixed_episodes
+ORDER BY logic, first_bucket_s;
+
+WITH sample(bucket_s, cpu_ms) AS (
+  VALUES
+    (0, 50.0), (1, 60.0), (2, 1.0), (3, 1.0),
+    (4, 55.0), (5, 45.0), (6, 1.0)
+),
+params AS (SELECT 20.0 AS spike_cpu_ms),
+flagged AS (
+  SELECT bucket_s, cpu_ms,
+         CASE WHEN cpu_ms >= (SELECT spike_cpu_ms FROM params) THEN 1 ELSE 0 END AS spike
+  FROM sample
+),
+old_grouped AS (
+  SELECT bucket_s, cpu_ms, spike,
+         bucket_s - ROW_NUMBER() OVER (ORDER BY bucket_s) AS grp
+  FROM flagged
+),
+old_episodes AS (
+  SELECT MIN(bucket_s) AS first_bucket_s, MAX(bucket_s) AS last_bucket_s
+  FROM old_grouped WHERE spike = 1 GROUP BY grp
+),
+fixed_spikes AS (
+  SELECT bucket_s, cpu_ms,
+         bucket_s - ROW_NUMBER() OVER (ORDER BY bucket_s) AS grp
+  FROM flagged WHERE spike = 1
+),
+fixed_episodes AS (
+  SELECT MIN(bucket_s) AS first_bucket_s, MAX(bucket_s) AS last_bucket_s
+  FROM fixed_spikes GROUP BY grp
+)
+SELECT
+  (SELECT COUNT(*) FROM old_episodes) AS old_episode_count,
+  (SELECT COUNT(*) FROM fixed_episodes) AS fixed_episode_count;
diff -ruN '--exclude=SHA256SUMS' '--exclude=CHANGES.diff' '--exclude=outputs' v2_test/validation/tests/perf_window_guard_test.sql v2_modify/validation/tests/perf_window_guard_test.sql
--- v2_test/validation/tests/perf_window_guard_test.sql	1970-01-01 08:00:00.000000000 +0800
+++ v2_modify/validation/tests/perf_window_guard_test.sql	2026-10-17 20:08:00.018506997 +0800
@@ -0,0 +1,32 @@
+-- Guard test for sql/16a-perf-window-check.sql.
+-- Windows are relative to this trace's trace_bounds.start_ts.
+-- Expected: 'inside' -> OK, 'outside' -> OUT_OF_TRACE.
+WITH bounds AS (
+  SELECT start_ts, end_ts FROM trace_bounds
+), cases(name, spike_start_ms, spike_end_ms, quiet_start_ms, quiet_end_ms) AS (
+  VALUES
+    ('inside',  1000, 2000,  3000,  4000),
+    ('outside', 20000, 21000, 22000, 23000)
+), windows AS (
+  SELECT
+    c.name,
+    b.start_ts + c.spike_start_ms * 1000000 AS spike_start_ts,
+    b.start_ts + c.spike_end_ms   * 1000000 AS spike_end_ts,
+    b.start_ts + c.quiet_start_ms * 1000000 AS quiet_start_ts,
+    b.start_ts + c.quiet_end_ms   * 1000000 AS quiet_end_ts,
+    b.start_ts,
+    b.end_ts
+  FROM bounds b, cases c
+)
+SELECT
+  name,
+  CASE
+    WHEN spike_start_ts < start_ts OR spike_end_ts > end_ts
+      OR quiet_start_ts < start_ts OR quiet_end_ts > end_ts
+    THEN 'OUT_OF_TRACE'
+    WHEN spike_start_ts >= spike_end_ts OR quiet_start_ts >= quiet_end_ts
+    THEN 'INVALID_RANGE'
+    ELSE 'OK'
+  END AS window_check
+FROM windows
+ORDER BY name;
diff -ruN '--exclude=SHA256SUMS' '--exclude=CHANGES.diff' '--exclude=outputs' v2_test/validation/tests/real_trace_overlap_test.sql v2_modify/validation/tests/real_trace_overlap_test.sql
--- v2_test/validation/tests/real_trace_overlap_test.sql	1970-01-01 08:00:00.000000000 +0800
+++ v2_modify/validation/tests/real_trace_overlap_test.sql	2026-10-17 20:07:47.374576227 +0800
@@ -0,0 +1,42 @@
+-- Real-trace regression for the bucket intersection (sql/10 formula).
+-- This does NOT use worker_app data; it uses any trace containing sched
+-- slices of 90-120 ms that cross a 100 ms bucket edge.
+-- Expected: total_overlap_ns == dur, diff_ns == 0 for every sampled slice.
+WITH RECURSIVE
+bounds AS (SELECT start_ts, end_ts FROM trace_bounds),
+buckets(bucket) AS (
+  SELECT 0
+  UNION ALL
+  SELECT bucket + 1 FROM buckets
+  WHERE bucket + 1 <
+        (SELECT CAST((end_ts - start_ts + 99999999) / 100000000 AS INTEGER) FROM bounds)
+),
+samples AS (
+  SELECT s.id, s.ts, s.dur
+  FROM sched_slice s, bounds b
+  WHERE s.dur BETWEEN 90000000 AND 120000000
+    AND s.ts >= b.start_ts
+    AND s.ts < b.end_ts
+    AND CAST((s.ts - b.start_ts) / 100000000 AS INTEGER)
+        <> CAST((s.ts + s.dur - 1 - b.start_ts) / 100000000 AS INTEGER)
+  ORDER BY s.ts
+  LIMIT 5
+),
+overlapped AS (
+  SELECT
+    s.id,
+    s.ts,
+    s.dur,
+    MIN(s.ts + s.dur, b.start_ts + (bk.bucket + 1) * 100000000)
+      - MAX(s.ts, b.start_ts + bk.bucket * 100000000) AS overlap_ns
+  FROM samples s
+  CROSS JOIN bounds b
+  JOIN buckets bk
+    ON s.ts < b.start_ts + (bk.bucket + 1) * 100000000
+   AND s.ts + s.dur > b.start_ts + bk.bucket * 100000000
+)
+SELECT id, ts, dur, SUM(overlap_ns) AS total_overlap_ns,
+       SUM(overlap_ns) - dur AS diff_ns
+FROM overlapped
+GROUP BY id, ts, dur
+ORDER BY ts;
diff -ruN '--exclude=SHA256SUMS' '--exclude=CHANGES.diff' '--exclude=outputs' v2_test/validation/tests/shell_lifecycle_dryrun.sh v2_modify/validation/tests/shell_lifecycle_dryrun.sh
--- v2_test/validation/tests/shell_lifecycle_dryrun.sh	1970-01-01 08:00:00.000000000 +0800
+++ v2_modify/validation/tests/shell_lifecycle_dryrun.sh	2026-10-17 20:18:16.530128841 +0800
@@ -0,0 +1,108 @@
+#!/bin/sh
+# Host-side dry run for the remote lifecycle scripts. No board, no real
+# tracebox, no worker_app: it uses mock binaries to verify PID handling,
+# observation time, stop/flush ordering, and pull failure propagation.
+set -eu
+
+FIX=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+ROOT=$(mktemp -d "${TMPDIR:-/tmp}/perfetto-lifecycle.XXXXXX")
+trap 'rm -rf "$ROOT"' EXIT
+
+mkdir -p "$ROOT/bin" "$ROOT/work" "$ROOT/app" "$ROOT/pull"
+
+cat > "$ROOT/bin/tracebox" <<'EOF'
+#!/bin/sh
+if [ "${1:-}" = "--version" ]; then echo "v57.1-mock"; exit 0; fi
+if [ "${1:-}" = "perfetto" ]; then echo "PRODUCERS: heapprofd"; exit 0; fi
+out=""
+prev=""
+for a in "$@"; do
+  if [ "$prev" = "-o" ]; then out=$a; fi
+  prev=$a
+done
+[ -n "$out" ] || { echo "mock tracebox: no -o" >&2; exit 2; }
+case "$*" in
+  *C1-worker-timeline*|*C3-worker-cpu-profile*)
+    ( sleep 2; printf "mock-scheduled-trace\n" > "$out"; exit 0 ) &
+    echo $!
+    exit 0
+    ;;
+esac
+(
+  trap 'printf "mock-trace\n" > "$out"; exit 0' INT TERM
+  while :; do sleep 0.1; done
+) &
+echo $!
+EOF
+chmod +x "$ROOT/bin/tracebox"
+
+cat > "$ROOT/app/worker_app" <<'EOF'
+#!/bin/sh
+echo "mock app started"
+trap 'echo "mock app term"; exit 0' TERM INT
+while :; do sleep 0.2; done
+EOF
+chmod +x "$ROOT/app/worker_app"
+
+: > "$ROOT/work/libheapprofd_glibc_preload.so"
+: > "$ROOT/work/C2-worker-native-alloc.pbtxt"
+: > "$ROOT/work/C1-worker-timeline.pbtxt"
+: > "$ROOT/work/C3-worker-cpu-profile.pbtxt"
+printf "mock C1 trace\n" > "$ROOT/work/C1.pftrace"
+
+echo "== C2 lifecycle dry run =="
+WORK="$ROOT/work" TRACEBOX="$ROOT/bin/tracebox" OBSERVE_S=2 \
+  sh "$FIX/scripts/remote_c2.sh" "$ROOT/app" "$ROOT/app/worker_app" ""
+[ -s "$ROOT/work/C2.pftrace" ] || { echo "FAIL: C2 trace empty"; exit 1; }
+grep -q "C2 DONE" "$ROOT/work/C2.status" || { echo "FAIL: no DONE"; exit 1; }
+echo "PASS: C2 lifecycle, trace non-empty"
+
+echo "== C1/C3 completion dry run =="
+WORK="$ROOT/work" TRACEBOX="$ROOT/bin/tracebox" sh "$FIX/scripts/remote_c1.sh"
+WORK="$ROOT/work" TRACEBOX="$ROOT/bin/tracebox" sh "$FIX/scripts/remote_c3.sh"
+[ -s "$ROOT/work/C1.pftrace" ] || { echo "FAIL: C1 empty"; exit 1; }
+[ -s "$ROOT/work/C3.pftrace" ] || { echo "FAIL: C3 empty"; exit 1; }
+grep -q "C1 DONE" "$ROOT/work/C1.status" || { echo "FAIL: C1 no DONE"; exit 1; }
+grep -q "C3 DONE" "$ROOT/work/C3.status" || { echo "FAIL: C3 no DONE"; exit 1; }
+echo "PASS: C1/C3 completion, non-empty outputs"
+
+echo "== remote_stop dry run =="
+WORK="$ROOT/work" TRACEBOX="$ROOT/bin/tracebox" sh "$FIX/scripts/remote_stop.sh" C1
+if WORK="$ROOT/work" TRACEBOX="$ROOT/bin/tracebox" sh "$FIX/scripts/remote_stop.sh" MISSING; then
+  echo "FAIL: stop of missing pid returned success"; exit 1
+else
+  echo "PASS: missing pid propagated"
+fi
+
+cat > "$ROOT/bin/scp" <<'EOF'
+#!/bin/sh
+# fake scp: -q SRC DST
+src=$2; dst=$3
+case "$src" in
+  *MISSING*) echo "fake scp: no such file" >&2; exit 1;;
+esac
+cp "${FAKE_SCP_SRC:?}" "$dst"
+EOF
+chmod +x "$ROOT/bin/scp"
+
+echo "== host_pull success =="
+PATH="$ROOT/bin:$PATH" WORK="$ROOT/work" FAKE_SCP_SRC="$ROOT/work/C1.pftrace" \
+  sh "$FIX/scripts/host_pull.sh" fakeboard "$ROOT/pull" C1.pftrace
+echo "PASS: pull success"
+
+echo "== host_pull missing file =="
+if PATH="$ROOT/bin:$PATH" WORK="$ROOT/work" FAKE_SCP_SRC="$ROOT/work/C1.pftrace" \
+  sh "$FIX/scripts/host_pull.sh" fakeboard "$ROOT/pull" MISSING.pftrace; then
+  echo "FAIL: pull of missing file returned success"; exit 1
+else
+  echo "PASS: pull failure propagated"
+fi
+
+echo "== host_pull empty file =="
+: > "$ROOT/work/EMPTY.pftrace"
+if PATH="$ROOT/bin:$PATH" WORK="$ROOT/work" FAKE_SCP_SRC="$ROOT/work/EMPTY.pftrace" \
+  sh "$FIX/scripts/host_pull.sh" fakeboard "$ROOT/pull" EMPTY.pftrace; then
+  echo "FAIL: pull of empty file returned success"; exit 1
+else
+  echo "PASS: empty file rejected"
+fi
