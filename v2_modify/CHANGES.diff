+++ v2_modify/validation/tests/bucket_overlap_old_vs_new.sql	2026-10-17 20:13:48.409815882 +0800
@@ -0,0 +1,30 @@
+-- Demonstrates the old vs fixed bucket attribution for a 90 ms interval
+-- starting at 95 ms. OLD: all 90 ms is charged to bucket 0. FIXED: 5 ms in
+-- bucket 0 and 85 ms in bucket 1. This is the concrete 90-120 ms boundary case.
+WITH RECURSIVE
+params AS (SELECT 100000000 AS bucket_ns),
+buckets(bucket) AS (
+  SELECT 0 UNION ALL SELECT bucket + 1 FROM buckets WHERE bucket < 2
+),
+sample(name, ts, dur) AS (
+  VALUES ('A_90ms_cross', 95000000, 90000000)
+),
+old_attribution AS (
+  SELECT name, ts, dur,
+         CAST(ts / (SELECT bucket_ns FROM params) AS INTEGER) AS old_bucket,
+         dur AS old_ms
+  FROM sample
+),
+new_attribution AS (
+  SELECT s.name, bk.bucket,
+         (MIN(s.ts + s.dur, (bk.bucket + 1) * p.bucket_ns)
+          - MAX(s.ts, bk.bucket * p.bucket_ns)) / 1000000.0 AS new_ms
+  FROM sample s CROSS JOIN buckets bk CROSS JOIN params p
+  WHERE s.ts < (bk.bucket + 1) * p.bucket_ns
+    AND s.ts + s.dur > bk.bucket * p.bucket_ns
+)
+SELECT 'OLD' AS logic, old_bucket AS bucket, old_ms / 1000000.0 AS ms
+FROM old_attribution
+UNION ALL
+SELECT 'FIXED', bucket, new_ms FROM new_attribution
+ORDER BY logic, bucket;
diff -ruN '--exclude=SHA256SUMS' '--exclude=CHANGES.diff' '--exclude=outputs' v2_test/validation/tests/bucket_overlap_test.sql v2_modify/validation/tests/bucket_overlap_test.sql
--- v2_test/validation/tests/bucket_overlap_test.sql	1970-01-01 08:00:00.000000000 +0800
+++ v2_modify/validation/tests/bucket_overlap_test.sql	2026-10-17 20:07:39.258625235 +0800
@@ -0,0 +1,69 @@
+-- Synthetic test for the interval/bucket intersection used by sql/10 and 11.
+-- Intervals are in ns; buckets are 100 ms.
+-- Expected: every "diff_ns" is 0; 90 ms and 120 ms intervals starting at
+-- 95 ms must split across the 100 ms boundary (5 ms in bucket 0, remainder
+-- in later buckets), not be charged entirely to bucket 0.
+WITH RECURSIVE
+params AS (SELECT 100000000 AS bucket_ns),
+buckets(bucket) AS (
+  SELECT 0
+  UNION ALL
+  SELECT bucket + 1 FROM buckets WHERE bucket < 4
+),
+intervals(name, ts, dur) AS (
+  VALUES
+    ('A_90ms_cross',   95000000,  90000000),
+    ('B_120ms_cross',  95000000, 120000000),
+    ('C_exact_100ms', 100000000, 100000000),
+    ('D_250ms_span',   50000000, 250000000),
+    ('E_1ns_edge',     99999999,   1000000)
+),
+overlapped AS (
+  SELECT
+    i.name,
+    i.ts,
+    i.dur,
+    bk.bucket,
+    MIN(i.ts + i.dur, (bk.bucket + 1) * p.bucket_ns)
+      - MAX(i.ts, bk.bucket * p.bucket_ns) AS overlap_ns
+  FROM intervals i
+  CROSS JOIN buckets bk
+  CROSS JOIN params p
+  WHERE i.ts < (bk.bucket + 1) * p.bucket_ns
+    AND i.ts + i.dur > bk.bucket * p.bucket_ns
+)
+SELECT name, bucket, overlap_ns
+FROM overlapped
+ORDER BY name, bucket;
+
+WITH RECURSIVE
+params AS (SELECT 100000000 AS bucket_ns),
+buckets(bucket) AS (
+  SELECT 0
+  UNION ALL
+  SELECT bucket + 1 FROM buckets WHERE bucket < 4
+),
+intervals(name, ts, dur) AS (
+  VALUES
+    ('A_90ms_cross',   95000000,  90000000),
+    ('B_120ms_cross',  95000000, 120000000),
+    ('C_exact_100ms', 100000000, 100000000),
+    ('D_250ms_span',   50000000, 250000000),
+    ('E_1ns_edge',     99999999,   1000000)
+),
+overlapped AS (
+  SELECT
+    i.name, i.dur,
+    MIN(i.ts + i.dur, (bk.bucket + 1) * p.bucket_ns)
+      - MAX(i.ts, bk.bucket * p.bucket_ns) AS overlap_ns
+  FROM intervals i
+  CROSS JOIN buckets bk
+  CROSS JOIN params p
+  WHERE i.ts < (bk.bucket + 1) * p.bucket_ns
+    AND i.ts + i.dur > bk.bucket * p.bucket_ns
+)
+SELECT name, dur, SUM(overlap_ns) AS total_overlap_ns,
+       SUM(overlap_ns) - dur AS diff_ns
+FROM overlapped
+GROUP BY name, dur
+ORDER BY name;
