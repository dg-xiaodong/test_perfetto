# C1: low-overhead timeline for worker_app (Linux/ARM64, tracebox v57.1)
# Purpose: shape/period of CPU jitter; RSS/page-fault/reclaim/DVFS/scheduler context.
# No heapprofd, no perf: this pass must not create the jitter it measures.
# Validate against the collector's descriptor when available; see PLAN.md.

buffers { size_kb: 16384 fill_policy: RING_BUFFER }   # 0: ftrace (high volume)
buffers { size_kb: 4096  fill_policy: RING_BUFFER }   # 1: process_stats
buffers { size_kb: 4096  fill_policy: RING_BUFFER }   # 2: sys_stats

duration_ms: 30000

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      record_thread_names: true
      proc_stats_poll_ms: 1000
      record_process_runtime: true   # utime/stime from /proc/<pid>/stat
      # scan_smaps_rollup: true      # only if root + hidepid permits; expensive
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    target_buffer: 2
    sys_stats_config {
      meminfo_period_ms: 1000
      meminfo_counters: MEMINFO_MEM_TOTAL
      meminfo_counters: MEMINFO_MEM_FREE
      meminfo_counters: MEMINFO_MEM_AVAILABLE
      meminfo_counters: MEMINFO_ANON_PAGES
      meminfo_counters: MEMINFO_SHMEM
      meminfo_counters: MEMINFO_SLAB
      meminfo_counters: MEMINFO_CMA_FREE
      vmstat_period_ms: 1000
      vmstat_counters: VMSTAT_NR_FREE_PAGES
      vmstat_counters: VMSTAT_PGFAULT
      vmstat_counters: VMSTAT_PGMAJFAULT
      vmstat_counters: VMSTAT_PSWPIN
      vmstat_counters: VMSTAT_PSWPOUT
      stat_period_ms: 1000
      stat_counters: STAT_CPU_TIMES
      cpufreq_period_ms: 1000
    }
  }
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      buffer_size_kb: 2048          # per-CPU ftrace ring; 2048 KiB * N CPUs
      drain_period_ms: 250
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "kmem/rss_stat"       # absolute per-category RSS accounting
      ftrace_events: "vmscan/mm_vmscan_direct_reclaim_begin"
      ftrace_events: "vmscan/mm_vmscan_direct_reclaim_end"
      ftrace_events: "compaction/mm_compaction_begin"
      ftrace_events: "compaction/mm_compaction_end"
      ftrace_events: "ftrace/print"        # existing trace_marker only; no instrumentation
    }
  }
}
