# C3: CPU callstack attribution for worker_app (linux.perf + sched timeline)
# Prerequisite: linux.perf producer present in tracebox and perf_event_open
# permitted for the target. Verify with the preflight in PLAN.md.
# The default here uses the libunwindstack (DWARF) user unwinder. If worker_app
# is built with -fno-omit-frame-pointer -fno-optimize-sibling-calls, set
# user_frames: UNWIND_FRAME_POINTER for lower unwinder cost.

buffers { size_kb: 8192  fill_policy: RING_BUFFER }   # 0: ftrace
buffers { size_kb: 4096  fill_policy: RING_BUFFER }   # 1: process_stats
buffers { size_kb: 16384 fill_policy: RING_BUFFER }   # 2: linux.perf packets

duration_ms: 30000

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      record_thread_names: true
      proc_stats_poll_ms: 1000
      record_process_runtime: true
    }
  }
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      buffer_size_kb: 1024
      drain_period_ms: 250
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "ftrace/print"
    }
  }
}

data_sources {
  config {
    name: "linux.perf"
    target_buffer: 2
    perf_event_config {
      timebase {
        frequency: 500              # SW_CPU_CLOCK; 500 Hz per CPU, then scope-filtered
      }
      callstack_sampling {
        scope {
          target_cmdline: "worker_app"
        }
        kernel_frames: false        # user code only; enable only if kptr_restrict permits
      }
      ring_buffer_pages: 256        # per-CPU perf ring, 256 * 4 KiB = 1 MiB/CPU
      max_daemon_memory_kb: 32768
      max_enqueued_footprint_kb: 32768
    }
  }
}
